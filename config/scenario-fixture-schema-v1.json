{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounce scenario fixture (calibration / held-out store)",
  "description": "Pinned at I-002-T4 for I-003 scenario store. Rational quantities are exact strings (Fraction syntax).",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "provenance_tier",
    "family",
    "curve",
    "initial_state",
    "physics",
    "reference_events",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "provenance_tier": { "type": "integer", "enum": [1, 2] },
    "family": { "type": "string" },
    "curve": {
      "type": "object",
      "required": ["curve_id", "family", "coeffs", "domain"],
      "properties": {
        "curve_id": { "type": "string" },
        "family": { "const": "polynomial" },
        "coeffs": { "type": "array", "items": { "type": "string" } },
        "domain": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string" }
        }
      }
    },
    "initial_state": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ball_id", "pos", "vel", "radius", "restitution"],
        "properties": {
          "ball_id": { "type": "integer" },
          "pos": {
            "type": "object",
            "required": ["x", "y"],
            "properties": { "x": { "type": "string" }, "y": { "type": "string" } }
          },
          "vel": {
            "type": "object",
            "required": ["vx", "vy"],
            "properties": { "vx": { "type": "string" }, "vy": { "type": "string" } }
          },
          "radius": { "type": "string" },
          "restitution": { "type": "string" }
        }
      }
    },
    "physics": {
      "type": "object",
      "required": ["gravity"],
      "properties": { "gravity": { "type": "string" } }
    },
    "reference_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "t", "ball_id", "contact", "tier"],
        "properties": {
          "seq": { "type": "integer" },
          "t": { "type": "string" },
          "ball_id": { "type": "integer" },
          "contact": {
            "type": "object",
            "required": ["x", "y"],
            "properties": { "x": { "type": "string" }, "y": { "type": "string" } }
          },
          "tier": { "type": "integer", "enum": [1, 2] }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["method", "residual_max"],
      "properties": {
        "method": { "type": "string" },
        "residual_max": { "type": "string" }
      }
    },
    "claims": { "type": "object" }
  }
}
